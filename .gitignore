!R/Len_optim_data_MWI_8_risk_groups.RData
!R/Len_optim_data_ZWE_4_risk_groups.RData
!R/Len_optim_data_ZWE_8_risk_groups.RData
!R/Len_optim_data_ZAF_4_risk_groups.RData
!R/Len_optim_data_ZAF_8_risk_groups.RData

# BUT keep these four core scripts
!R/Allocate_PreP_All_Country_Model.R
!R/Allocate_PrEP_Data_Cleaning_All_Country.R
!R/NAOMI_config_Allocate_PrEP_allcountry_v3.R
